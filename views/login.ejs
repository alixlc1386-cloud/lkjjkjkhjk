<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>ورود | YASIN AI ADS</title>
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
  <canvas id="bg3d"></canvas>
  <div class="glow g1"></div>
  <div class="glow g2"></div>
  <div class="glow g3"></div>
  <main class="loginwrap">
    <section class="card login">
      <div class="brandmark big">YA</div>
      <small>ورود کاربران</small>
      <h1>YASIN AI ADS</h1>
      <p>شماره موبایل ثبت‌شده و رمز سایت را وارد کن.</p>
      <% if (err) { %>
        <div class="error"><%= err %></div>
      <% } %>
      <form method="post" action="login.php">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input name="phone" type="tel" required placeholder="شماره موبایل">
        <input name="password" type="password" required placeholder="رمز عبور">
        <button class="primary" type="submit">ورود به پنل</button>
      </form>
      <a class="setupLink" href="register.php">حساب ندارم؛ ثبت‌نام</a>
    </section>
  </main>
  <script src="assets/fx.js"></script>
</body>
</html>
